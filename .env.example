# Get a key at https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=your_key_here
# TTS voice from the Voice Agent API voice catalog (alba, eve, george, jane, jean, mary, michael, anna, charles, paul, vera)
VOICE_STUDIO_VOICE=michael
# Optional: LLM Gateway model for topic -> script generation (requires LLM Gateway access)
VOICE_STUDIO_LLM_MODEL=claude-sonnet-4-6
